{
	"name": "coin-race",
	"version": "2.0.0",
	"description": "A small real-time multiplayer coin collecting game",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "concurrently -n server,client \"tsx watch src/server/index.ts\" \"vite\"",
		"build": "vite build && tsc -p tsconfig.server.json",
		"start": "node dist/server/server/index.js",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json",
		"format": "prettier --write ."
	},
	"license": "MIT",
	"dependencies": {
		"express": "^5.3.0",
		"helmet": "^8.3.0",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"concurrently": "^10.0.6",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
