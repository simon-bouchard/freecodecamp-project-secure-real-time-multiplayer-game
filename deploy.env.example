# Copy to deploy.env (git-ignored) and fill in.
# SSH host or alias from ~/.ssh/config.
DEPLOY_HOST=user@my-server
# Folder the systemd service runs from (its WorkingDirectory); data/ there is left alone.
DEPLOY_DIR=/srv/coin-race
# systemd unit name.
DEPLOY_SERVICE=coin-race
# Optional: public URL checked after the restart.
DEPLOY_URL=
